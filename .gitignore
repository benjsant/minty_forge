# ======================================
# MintyForge - Python project .gitignore
# Compatible with Linux Mint / Ubuntu
# ======================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.py.class
*.egg
*.egg-info/
*.manifest
*.spec

# --- Virtual environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- uv ---
# uv.lock est volontairement commite (installs reproductibles)
# NE PAS ajouter uv.lock ici

# --- Logs & temp files ---
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.DS_Store
*.tar
*.zip
*.gz
*.rar
*.7z

# --- Editor & IDE specific ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Build & distribution ---
build/
dist/
pip-wheel-metadata/
*.egg-info/
__pycache__/
*.manifest
*.spec

# --- System files ---
Thumbs.db
Desktop.ini
ehthumbs.db

# --- MintyForge specific ---
# Generated dconf files (user-specific)
configs/dconf_custom.dconf

# Themes clones localement (crees a la demande par themes_install.py)
themes/
icons/
cursors/

# State manager data (user-specific)
data/

# Generated installer logs or temp files
logs/
output/
cache/
.tmp/

# Flask instance files
instance/
.webassets-cache

# --- Misc ---
*.bak
*.old
*.orig

# --- Optional: ignore shell scripts backups if any ---
*.sh~
